# Copy with npm run setup; this generates a strong local admin password.
HOST=0.0.0.0
PORT=3000
TRADELENS_PASSWORD=
TRADELENS_DB=tradelens.sqlite
TRADELENS_DEMO=0
# Use the exact HTTPS Codespaces forwarded URL or deployment origin.
# Codespaces origin is inferred automatically when not configured.
TRADELENS_ORIGIN=

SHOPIFY_SHOP=
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_WEBHOOK_SECRET=
CJ_ACCESS_TOKEN=
PRINTIFY_API_TOKEN=
TRADELENS_DISCOVERY_KEYWORDS=smart,charger,usb

META_ADS_TOKEN=
META_AD_ACCOUNT_ID=
# Pick a version currently supported by your Meta app; do not include a URL.
META_GRAPH_VERSION=

OPENAI_API_KEY=
TRADELENS_AI_MODEL=
RESEND_API_KEY=
TRADELENS_ALERT_FROM=
TRADELENS_ALERT_TO=

# Enable only after confirming merchant permissions and provider quotas.
TRADELENS_AUTOMATION=0
TRADELENS_AUTO_AI=0
